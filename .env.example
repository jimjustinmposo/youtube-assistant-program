# ---------------------------------------------------------------------------
# Local YouTube Content Assistant - environment configuration
#
# Copy this file to `.env` and adjust as needed.
# `.env` is gitignored. NEVER commit real secrets. NEVER put a secret in a
# variable prefixed with VITE_ (those are inlined into browser JavaScript).
# ---------------------------------------------------------------------------

# --- Local backend server ---------------------------------------------------
# The backend binds to loopback only. It is a local application, not a service.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# --- Local storage ----------------------------------------------------------
# Root folder for the SQLite database and uploaded files.
# Relative paths are resolved from the repository root.
DATA_DIR=./data

# --- Upload limits (megabytes) ---------------------------------------------
MAX_VIDEO_SIZE_MB=4096
MAX_THUMBNAIL_SIZE_MB=10

# --- Local frontend (Vite dev server) --------------------------------------
VITE_PORT=3000
# Vite proxies /api to this backend URL. Update if PORT changes.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# --- Composio (used from Phase 5 onward - NOT used in Phase 1) --------------
# Server-side only. Never exposed to the browser.
COMPOSIO_API_KEY=
# Optional: pin a specific Composio YouTube connected account (Phase 5).
COMPOSIO_YOUTUBE_CONNECTED_ACCOUNT_ID=
